@startuml
autonumber
skinparam sequenceMessageAlign left

actor Student
participant BookingService
participant BookingRepository

Student -> BookingService : bookRoom(studentId, roomId, startTime, durationMinutes)
activate BookingService

BookingService -> BookingService : validateRequest(startTime, durationMinutes)
note right
  R1: start is in the future,
  0 < duration <= 120 minutes
end note

alt R1 fails
  BookingService --> Student : rejection(INVALID_TIME_OR_DURATION)
else R1 passes
  BookingService -> BookingRepository : findRoom(roomId)
  activate BookingRepository
  BookingRepository --> BookingService : room
  deactivate BookingRepository

  BookingService -> BookingRepository : findActiveBookings(roomId, startTime, endTime)
  activate BookingRepository
  BookingRepository --> BookingService : overlappingBookings
  deactivate BookingRepository

  alt room is blocked
    note over BookingService : R3 fails
    BookingService --> Student : rejection(ROOM_BLOCKED)
  else overlappingBookings is not empty
    note over BookingService : R2 fails
    BookingService --> Student : rejection(SLOT_UNAVAILABLE)
  else room is not blocked and no overlap
    note over BookingService : R1, R2, R3 satisfied
    BookingService -> BookingService : createBooking(studentId, roomId, startTime, durationMinutes)
    BookingService -> BookingService : confirm(booking)
    note right : R4: generates confirmationId
    BookingService -> BookingRepository : saveBooking(booking)
    activate BookingRepository
    BookingRepository --> BookingService : savedBooking
    deactivate BookingRepository
    BookingService --> Student : confirmation(bookingId, roomId, startTime, endTime, confirmationId)
  end
end

deactivate BookingService
@enduml